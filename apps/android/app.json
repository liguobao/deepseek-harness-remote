{
  "expo": {
    "name": "DSH Remote",
    "slug": "dsh-remote",
    "scheme": "dshremote",
    "version": "0.3.29",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "io.github.liguobao.dshremote",
      "versionCode": 13,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground-adaptive.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-file-system",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-brand.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F5F7"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 31,
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "android": ["en-US", "zh-CN"]
          }
        }
      ]
    ]
  }
}
