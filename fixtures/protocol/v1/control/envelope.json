        "timestamp": 1700000000000,
        "payload": {
          "nonce": "fixture-nonce-4"
        }
      },
      "expect": {
        "accepted": false
      }
    },
    {
      "name": "reject-missing-control-timestamp",
      "operation": "parseControlFrame",
      "input": {
        "v": 1,
        "id": "fixture-frame-envelope-5",
        "type": "ping",
        "payload": {
          "nonce": "fixture-nonce-5"
        }
      },
      "expect": {
